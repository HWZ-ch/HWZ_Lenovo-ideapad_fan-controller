<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>LenovoCoolBoost</AssemblyName>
    <RootNamespace>LenovoCoolBoost</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyTitle>Lenovo 降温除尘持续激活</AssemblyTitle>
    <AssemblyDescription>一键开关联想风扇最大转速(EnergyDrv 除尘命令)</AssemblyDescription>
    <Version>1.2.1</Version>
    <FileVersion>1.2.1.0</FileVersion>
    <AssemblyVersion>1.2.1.0</AssemblyVersion>
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <!-- 嵌入图标供托盘与窗口使用（ApplicationIcon 只管 exe 的资源图标） -->
    <EmbeddedResource Include="app.ico">
      <LogicalName>LenovoCoolBoost.app.ico</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>
